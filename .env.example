# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Session Configuration (REQUIRED - generate with: openssl rand -hex 32)
SESSION_SECRET=your_random_session_secret_here

# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# AI Provider Configuration
# Set to 'lmstudio' for local LM Studio, 'openrouter' for OpenRouter API,
# or 'opencodego' for OpenCode Go
# If not set, auto-detects based on which config is available (prefers LM Studio)
AI_PROVIDER=lmstudio

# LM Studio Configuration (local AI - no API key needed)
LMSTUDIO_URL=http://10.5.0.2:1234
LMSTUDIO_MODEL=llama-3.1-deephermes-r1-reasoning-8b-darkidol-instruct-1.2-uncensored

# OpenRouter API Configuration (cloud AI - requires API key)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=openrouter/free
# Tried in order when the default model is rate-limited or its provider errors
# OPENROUTER_FALLBACK_MODELS=inclusionai/ling-3.2-flash:free,nvidia/nemotron-3-ultra-550b-a55b:free

# OpenCode Go Configuration (cloud AI - requires API key)
OPENCODEGO_API_KEY=your_opencodego_api_key_here
OPENCODEGO_MODEL=deepseek-v4.1-flash
# Tried in order when the main model's content filter blocks a request (comma-separated)
OPENCODEGO_FALLBACK_MODELS=grok-4.7,kimi-k2.7-code

# Comic panel detection (z, n, p, 0 keys in the comic viewer) first looks for the gutters
# between panels (free and instant; COMIC_PANELS_GUTTERS=false skips it). Pages without clear
# gutters are sent to OpenCode Go when its key is set. The default model cannot read images, so name one that can
# to skip the failed first attempt on every page. Results are cached.
# AI_VISION_MODEL=grok-4.7
# When the model answers with one full-page panel (often a miss), the page is asked once more
# of this stronger model and its answer wins. Unset: the single-panel answer is accepted.
# AI_VISION_STRONG_MODEL=
# When OpenCode Go reports its usage limit, panel detection continues on OpenRouter (needs
# OPENROUTER_API_KEY) with OPENROUTER_DEFAULT_MODEL, which must be able to read images.
# AI_VISION_OPENROUTER_MODEL overrides it for panels; AI_VISION_OPENROUTER_STRONG_MODEL is the
# full-page retry model on OpenRouter.
# AI_VISION_OPENROUTER_MODEL=

# A decision model reads the page in one pass and generates no text, so it is faster and cheaper
# than a vision LLM. It runs after the gutter step and before the AI models above, and needs
# OPENROUTER_API_KEY. Only typesafe/jev-1.14 answers the box questions this needs. Pin the
# version: the decisions API is alpha. Unset: skipped.
# AI_VISION_DECISION_MODEL=typesafe/jev-1.14

# Set to any value to log AI provider configuration
# AI_DEBUG=1

# Note: server.js loads .env from this folder first, then from the parent folder

# Optional: passphrase that encrypts remembered logins (mega.nz etc.).
# If unset, a random key is generated into .credentials.key on first save.
CREDENTIALS_KEY=

# Saved logins can be changed from this machine and from devices on your private network.
# Set to off to allow this machine only.
CREDENTIALS_REMOTE=
