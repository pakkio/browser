<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="File Browser" Manufacturer="Pakkio" Version="$(var.Version)"
           UpgradeCode="7d3f5c1e-2b8a-4e6f-9a41-0c5b7e2d8f13" Scope="perUser">
    <!-- Same-version rebuilds replace the installed copy instead of being installed beside it -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of File Browser is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FileBrowser">
          <Files Include="$(var.Stage)\**" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartDir" Name="File Browser" />
    </StandardDirectory>

    <!-- `filebrowser` available in any new terminal -->
    <Component Id="PathEntry" Directory="INSTALLFOLDER" Guid="a3c9e1f4-6d27-4b85-8e0a-91f2c47d5b36">
      <RegistryValue Root="HKCU" Key="Software\FileBrowser" Name="PathEntry" Type="integer" Value="1" KeyPath="yes" />
      <Environment Id="PathEnv" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="no" Permanent="no" />
    </Component>

    <!-- Start menu: File Browser in its own window; asks which folder to open -->
    <Component Id="StartShortcut" Directory="StartDir" Guid="5e8b2d70-1a94-4c3f-b6d8-e47a0f93c215">
      <Shortcut Id="StartLnk" Name="File Browser" Target="[INSTALLFOLDER]app\filebrowser-app.exe"
                WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RemoveFolder Id="RmStartDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\FileBrowser" Name="StartShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Explorer: right-click a folder, a drive, or empty space inside a folder -->
    <Component Id="ExplorerVerbs" Directory="INSTALLFOLDER" Guid="c41d7a92-8e3b-4f06-a5d1-3b6e9f28c704">
      <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\FileBrowser">
        <RegistryValue Type="string" Value="Open with File Browser" />
        <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]filebrowser.ico" />
        <RegistryKey Key="command"><RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]app\filebrowser-app.exe&quot; &quot;%1&quot;" /></RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\FileBrowser">
        <RegistryValue Type="string" Value="Open File Browser here" />
        <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]filebrowser.ico" />
        <RegistryKey Key="command"><RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]app\filebrowser-app.exe&quot; &quot;%V&quot;" /></RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\FileBrowserHelp">
        <RegistryValue Type="string" Value="File Browser help &amp; shortcuts" />
        <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]filebrowser.ico" />
        <RegistryKey Key="command"><RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]app\filebrowser-app.exe&quot; --help-page &quot;%V&quot;" /></RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\Drive\shell\FileBrowser">
        <RegistryValue Type="string" Value="Open with File Browser" />
        <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]filebrowser.ico" />
        <RegistryKey Key="command"><RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]app\filebrowser-app.exe&quot; &quot;%1&quot;" /></RegistryKey>
      </RegistryKey>
      <RegistryValue Root="HKCU" Key="Software\FileBrowser" Name="ExplorerVerbs" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Tools downloaded on first run live outside the install folder; remove them on uninstall (not on upgrade) -->
    <Property Id="TOOLSDIR" Secure="yes" />
    <SetProperty Id="TOOLSDIR" Value="[LocalAppDataFolder]FileBrowser\tools" Before="CostFinalize"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <Component Id="ToolsCleanup" Directory="INSTALLFOLDER" Guid="9b1e4c28-3f60-4d7a-8c15-6a2d0e7b94f1">
      <RegistryValue Root="HKCU" Key="SoftwareFileBrowser" Name="ToolsCleanup" Type="integer" Value="1" KeyPath="yes" />
      <util:RemoveFolderEx On="uninstall" Property="TOOLSDIR" />
    </Component>

    <!-- Right after installing: fetch every tool that is not already on this machine (ffmpeg,
         Poppler, Ghostscript, Node.js for mega.nz), with a progress window. It runs on its own so a
         failed download never fails the install; the first launch tries again. -->
    <CustomAction Id="FetchTools" Directory="INSTALLFOLDER" Return="asyncNoWait" Impersonate="yes" Execute="immediate"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -STA -WindowStyle Hidden -File &quot;[INSTALLFOLDER]fetch-tools.ps1&quot; -Gui -Features mega" />
    <InstallExecuteSequence>
      <Custom Action="FetchTools" After="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <!-- Last page of the installer: offers to start File Browser right away -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch File Browser" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" Return="asyncNoWait" Impersonate="yes"
                  ExeCommand="&quot;[INSTALLFOLDER]app\filebrowser-app.exe&quot;" />
    <UI>
      <UIRef Id="WixUI_ErrorProgressText" />
      <DialogRef Id="ExitDialog" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <Icon Id="AppIcon" SourceFile="$(var.Stage)\filebrowser.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
  </Package>
</Wix>
